# Runtime
NODE_ENV=development
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001

# PostgreSQL (local Docker development only)
# Les ports côté hôte sont modifiables si 5432 est déjà occupé : dans ce cas,
# aligner DATABASE_URL sur la même valeur.
POSTGRES_DB=modelbenin
POSTGRES_USER=modelbenin
POSTGRES_PASSWORD=modelbenin
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://modelbenin:modelbenin@localhost:5432/modelbenin?schema=public

# Redis
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379

# Future integrations — do not commit real values.
DATA_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
