# Runtime
NODE_ENV=development
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001

# PostgreSQL (local Docker development only)
# Les ports côté hôte sont modifiables si 5432 est déjà occupé : dans ce cas,
# aligner DATABASE_URL sur la même valeur.
POSTGRES_DB=modelbenin
POSTGRES_USER=modelbenin
POSTGRES_PASSWORD=modelbenin
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://modelbenin:modelbenin@localhost:5432/modelbenin?schema=public

# Redis
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379

# Auth — replace every secret before any shared deployment.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
EMAIL_VERIFICATION_TTL_MINUTES=60

# Chiffrement au repos des données de profil (clé base64 de 32 octets).
DATA_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Compte administrateur créé par `pnpm db:seed` (mot de passe >= 10 caractères).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Stockage objet S3 (Cloudflare R2 en production, MinIO en local).
# Les valeurs par défaut correspondent au service minio de docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=modelbenin-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
